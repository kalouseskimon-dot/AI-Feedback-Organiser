      "parameters": {
        "jsCode": "const data = items[0].json;\n\nconst emailBody = `\n<div style=\"font-family: sans-serif; line-height: 1.6; color: #333;\">\n  <h2 style=\"color: ${data.urgencyColor};\">${data.category}</h2>\n  <p><strong>Urgency:</strong> ${data.urgency}</p>\n  <p><strong>Sentiment:</strong> ${data.sentiment}</p>\n  <div style=\"border-left: 3px solid ${data.urgencyColor}; padding-left: 10px;\">\n    ${data.html_email || `<p>${data.raw_ai_response}</p>`}\n  </div>\n</div>\n`;\n\nreturn [{ json: { html: emailBody } }];"
      },
