    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.raw_content }} {{ $json.subject_line }} {{ $json.sender_email }}",
        "needsFallback": true,
        "options": {
          "systemMessage": "You are a startup CX analyst. Read the feedback. Do not write anything other than the required information.\n\nFollow this format for your response:\nCategory: [bug, feature_request, or general]\nUrgency: [1 to 5]\nSummary: [A 10-word summary of the user's core point]\nSentiment: [Positive, Neutral, or Negative]\nSender_Email: [sender_email]"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        768,
        16
      ],
      "id": "338d4b85-34f7-4cd3-9969-a56893f57079",
      "name": "AI Agent",
      "retryOnFail": true
    },
    {
      "parameters": {
        "sendTo": "your_email",
        "subject": "Customer Feedback ",
        "message": "={{ $json.html }}",
        "options": {}
      },
