      "id": "d9389462-21fd-4c5b-aed4-3f046dc34eb9",
      "name": "3.1 Flash Lite",
      "credentials": {
        "googlePalmApi": {
          "id": "h3S0k9NLNpe4hxGh",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Define noise patterns\nconst noiseKeywords = ['unsubscribe', 'invoice', 'no-reply', 'receipt', 'order confirmation', 'shipping', 'welcome to'];\n\n// Define feedback indicators\nconst feedbackKeywords = ['feature', 'bug', 'problem', 'suggestion', 'idea', 'broken', 'improve', 'question', 'help'];\n\n// Filter all incoming items\nreturn items.filter(item => {\n  const snippet = (item.json.snippet || \"\").toString().toLowerCase();\n\n  const isNoise = noiseKeywords.some(word => snippet.includes(word));\n  const isFeedback = feedbackKeywords.some(word => snippet.includes(word));\n\n  // Keep only items that are NOT noise AND ARE feedback\n  return !isNoise && isFeedback;\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        96,
        -176
      ],
      "id": "6246d2bd-82c1-4e31-8436-27f9c3c72596",
      "name": "Noise Filtering"
    },
    {
      "parameters": {
        "jsCode": "const data = items[0].json;\n\nconst emailBody = `\n<div style=\"font-family: sans-serif; line-height: 1.6; color: #333;\">\n  <h2 style=\"color: ${data.urgencyColor};\">${data.category}</h2>\n  <p><strong>Urgency:</strong> ${data.urgency}</p>\n  <p><strong>Sentiment:</strong> ${data.sentiment}</p>\n  <div style=\"border-left: 3px solid ${data.urgencyColor}; padding-left: 10px;\">\n    ${data.html_email || `<p>${data.raw_ai_response}</p>`}\n  </div>\n</div>\n`;\n\nreturn [{ json: { html: emailBody } }];"
      },
