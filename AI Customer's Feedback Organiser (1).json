    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.raw_content }} {{ $json.subject_line }} {{ $json.sender_email }}",
        "needsFallback": true,
        "options": {
          "systemMessage": "You are a startup CX analyst. Read the feedback. Do not write anything other than the required information. Ignore any passwords, API keys, personal identifiers or sensitive information. Do not repeat or summarize them.\n\nFollow this format for your response:\nCategory: [bug, feature_request, or general]\nUrgency: [1 to 5]\nSummary: [A 10-word summary of the user's core point]\nSentiment: [Positive, Neutral, or Negative]"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1344,
        48
      ],
      "id": "c77791dd-d919-4148-926d-23ca4615e67a",
      "name": "AI Agent",
      "retryOnFail": true
    },
    {
      "parameters": {
        "sendTo": "kalouseskimon@gmail.com",
        "subject": "Customer Feedback ",
        "message": "={{ $json.html }}",
        "options": {}
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        2496,
        -96
      ],
      "id": "987aa3ec-a054-423c-aa44-2db4715a6034",
      "name": "Info Message",
      "webhookId": "143ca398-6246-4366-b13b-4c1c643a0dec",
      "credentials": {
        "gmailOAuth2": {
          "id": "K9UXy9HHQqJiX3ff",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const data = items[0].json;\n\n// Define the logic: Bug + Urgency >= 4 is \"Critical\"\nconst isCritical = data.category.toLowerCase() === 'bug' && parseInt(data.urgency) >= 4;\n\nconst accentColor = isCritical ? \"#e74c3c\" : \"#3498db\";\nconst headerText = isCritical ? \"!!! CRITICAL BUG ALERT !!!\" : \"New Feedback Alert\";\n\nconst htmlBody = `\n<div style=\"font-family: sans-serif; line-height: 1.6; color: #333; max-width: 600px;\">\n    <h2 style=\"color: ${accentColor};\">${headerText}</h2>\n    <div style=\"background: #f4f4f9; padding: 15px; border-left: 5px solid ${accentColor};\">\n        <p><strong>Category:</strong> ${data.category.toUpperCase()}</p>\n        <p><strong>Urgency:</strong> ${data.urgency}/5</p>\n        <p><strong>Sentiment:</strong> ${data.sentiment}</p>\n        <p><strong>Email:</strong> ${data.email_address}</p>\n    </div>\n    <h3 style=\"color: #2c3e50;\">Summary</h3>\n    <p>${data.summary}</p>\n    <br>\n    <a href=\"http://localhost:5678/workflow/PAnBgczV5o605QSF\" style=\"background: ${accentColor}; color: white; padding: 10px 15px; text-decoration: none; border-radius: 5px;\">\n        ${isCritical ? \"View & Resolve Immediately\" : \"View in Database\"}\n    </a>\n</div>\n`;\n\nreturn {\n    json: {\n        ...data,\n        email_address: data.email_address,   // ensure it exists in output\n        html_email: htmlBody,\n        is_critical: isCritical\n    }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        -96
      ],
      "id": "d7696940-1d24-4f82-8703-3e894d191df3",
      "name": "HTML Beautifier"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Grab the current item being processed in the loop\nconst inputData = $input.item.json;\n\n// Extract the raw text from the AI agent's evaluation string\nconst text = inputData.output || \"\";\n\n// Regex helper that captures until the next label OR end of text\nconst getField = (label) => {\n    const regex = new RegExp(`${label}:\\\\s*([\\\\s\\\\S]*?)(?=\\\\n[A-Za-z_]+:|$)`, 'i');\n    const match = text.match(regex);\n    return match ? match[1].trim() : \"Not Found\";\n};\n\nreturn {\n    category: getField('Category'),\n    urgency: parseInt(getField('Urgency')) || 0,\n    summary: getField('Summary'),\n    sentiment: getField('Sentiment'),\n    raw_ai_response: text // Keep for debugging\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1696,
        48
      ],
      "id": "fe5eb9b3-624c-4e42-8695-9f1588443938",
      "name": "JSON formatter"
    },
